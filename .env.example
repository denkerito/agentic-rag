GOOGLE_API_KEY=
# Password del superuser del container (docker-compose.yml)
POSTGRES_PASSWORD=postgres
# Superuser: usato solo da `python -m agentic_rag.db.init` per creare ruoli ed estensione
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/agentic_rag
# Proprietario dello schema: DDL, caricamento dati, indicizzazione
DATABASE_URL=postgresql://agentic_owner:owner_password@localhost:5432/agentic_rag
# Ruolo di sola lettura usato dall'agente
DATABASE_URL_AGENT=postgresql://agent_ro:agent_password@localhost:5432/agentic_rag
# Ruolo dell'API: scrive indagini ed eventi nello schema `app` (nessun accesso a `public`)
DATABASE_URL_APP=postgresql://app_rw:app_password@localhost:5432/agentic_rag
# Osservabilità (opzionale): token Logfire; senza token la traccia resta locale
LOGFIRE_TOKEN=

# Agente (opzionali): modello Pydantic AI e tetto di chiamate al modello per domanda
# AGENT_MODEL=google:gemini-3.5-flash-lite
# AGENT_MAX_REQUESTS=25

# API (opzionali): origini CORS del frontend (separate da virgola) e indagini eseguite in parallelo
# CORS_ORIGINS=http://localhost:5173
# MAX_INDAGINI_CONCORRENTI=3
